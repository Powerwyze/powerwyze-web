{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/ai-cards/:path*",
      "destination": "https://twncard.app",
      "permanent": true
    },
    {
      "source": "/ai-cards.html",
      "destination": "https://twncard.app",
      "permanent": true
    },
    {
      "source": "/ai-cards-builder",
      "destination": "https://twncard.app",
      "permanent": true
    },
    {
      "source": "/ai-cards-builder.html",
      "destination": "https://twncard.app",
      "permanent": true
    },
    {
      "source": "/ai-cards-pricing",
      "destination": "https://twncard.app",
      "permanent": true
    },
    {
      "source": "/ai-cards-pricing.html",
      "destination": "https://twncard.app",
      "permanent": true
    },
    {
      "source": "/ai-cards-thanks",
      "destination": "https://twncard.app",
      "permanent": true
    },
    {
      "source": "/ai-cards-thanks.html",
      "destination": "https://twncard.app",
      "permanent": true
    },
    {
      "source": "/api/ai-cards/:path*",
      "destination": "https://twncard.app",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.powerwyze.com"
        }
      ],
      "destination": "https://powerwyze.com/:path*",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/#our-work",
      "permanent": true
    },
    {
      "source": "/projects.html",
      "destination": "/#our-work",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/thanks",
      "destination": "/thanks.html"
    },
    {
      "source": "/thanks/",
      "destination": "/thanks.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/script.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ]
}
