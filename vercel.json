{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.powerwyze.com" }],
      "destination": "https://powerwyze.com/:path*",
      "permanent": true
    },
    {
      "source": "/api/ai-cards",
      "destination": "/ai-cards",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/ai-cards", "destination": "/ai-cards.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/script.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    }
  ]
}
